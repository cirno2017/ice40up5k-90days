
#include <iostream>
#include <cstdlib>
#include <cstdint>
#include <random>
#include "verilated.h"
#include "verilated_vcd_c.h"
#include "Vtop.h"

vluint64_t sim_time = 0;
constexpr vluint64_t CLK_HALF_PERIOD = 10;

// 软件参考模型变量
uint8_t ref_dff8_q  = 0U;
uint8_t ref_reg8_en_q = 0U;

int main(int argc, char** argv) {
    Verilated::commandArgs(argc, argv);
    Vtop* dut = new Vtop;

    Verilated::traceEverOn(true);
    VerilatedVcdC* trace = new VerilatedVcdC;
    dut->trace(trace, 99);
    trace->open("wave.vcd");

    // --------------------------
    // 0. 显式初始化采样：产生一次明确上升沿建立DUT已知状态
    // 先clk=0，设置 en=1 d=0，再做0→1上升沿，让触发器真正采样
    // --------------------------
    std::cout << "\n==== Pre‑test: explicit init clock edge to establish known state ====\n";
    dut->clk = 0;
    dut->en  = 1;
    dut->d   = 0x00;
    dut->eval();
    trace->dump(sim_time);

    // 上升沿
    sim_time += CLK_HALF_PERIOD;
    dut->clk = 1;
    dut->eval();
    trace->dump(sim_time);

    // 下降沿
    sim_time += CLK_HALF_PERIOD;
    dut->clk = 0;
    dut->eval();
    trace->dump(sim_time);

    // 从DUT硬件读出初始状态，不用硬编码0代替硬件采样结果
    ref_dff8_q      = static_cast<uint8_t>(dut->dff8_q);
    ref_reg8_en_q   = static_cast<uint8_t>(dut->reg8_en_q);
    std::printf("[%4luns] After init edge: dff8_q=0x%02X reg8_en_q=0x%02X\n",
        sim_time, (int)ref_dff8_q, (int)ref_reg8_en_q);

    int error_cnt = 0;

    auto check_dut = [&](){
        bool err1 = (static_cast<uint8_t>(dut->dff8_q) != ref_dff8_q);
        bool err2 = (static_cast<uint8_t>(dut->reg8_en_q) != ref_reg8_en_q);
        if(err1 || err2) {
            error_cnt++;
            std::cerr << "[MISMATCH] dut(dff8=0x" << std::hex << (int)dut->dff8_q
                      << ", reg8=0x" << (int)dut->reg8_en_q << ")"
                      << " ref(dff8=0x" << (int)ref_dff8_q
                      << ", reg8=0x" << (int)ref_reg8_en_q << ")\n";
        }
    };

    // ==============================
    // Test1：时钟停在低电平 clk=0，多次修改d，输出必须保持
    // ==============================
    std::cout << "\n==== Test1: CLK stay LOW (clk=0), modify d many times ====\n";
    // clk保持0，参考模型值不变（没有时钟沿，状态冻结）
    for(int i = 0; i < 5; i++){
        sim_time += CLK_HALF_PERIOD;
        dut->d = static_cast<uint8_t>(0x10 + i*0x11);
        dut->eval();
        trace->dump(sim_time);

        check_dut(); // 自动比对，出错统计error_cnt

        std::printf("[%4luns] clk=%d d=0x%02X | dut dff8_q=0x%02X reg8_en_q=0x%02X\n",
            sim_time, (int)dut->clk, (int)dut->d,
            (int)dut->dff8_q, (int)dut->reg8_en_q);
    }

    // ==============================
    // Test2：时钟停在高电平 clk=1，多次修改d/en，输出仍保持
    // ==============================
    std::cout << "\n==== Test2: CLK stay HIGH (clk=1), modify d & en many times ====\n";
    for(int i = 0; i < 5; i++){
        sim_time += CLK_HALF_PERIOD;
        dut->d  = static_cast<uint8_t>(0x30 + i*0x07);
        dut->en = (i & 1U) ? 1 : 0;
        dut->eval();
        trace->dump(sim_time);

        check_dut(); // 自动比对

        std::printf("[%4luns] clk=%d en=%d d=0x%02X | dut dff8_q=0x%02X reg8_en_q=0x%02X\n",
            sim_time, (int)dut->clk, (int)dut->en, (int)dut->d,
            (int)dut->dff8_q, (int)dut->reg8_en_q);
    }

    // ==============================
    // 确定序列测试：连续两拍禁用使能，再重新使能
    // ==============================
    std::cout << "\n==== Deterministic sequence: two cycles en=0, then en=1 ====\n";
    // cycle A: en=1, d=0xAA → 采样
    sim_time += CLK_HALF_PERIOD; dut->clk=0; dut->d=0xAA; dut->en=1; dut->eval(); trace->dump(sim_time);
    sim_time += CLK_HALF_PERIOD; dut->clk=1; dut->eval(); trace->dump(sim_time);
    ref_dff8_q = 0xAA;
    if(1) ref_reg8_en_q = 0xAA;
    check_dut();

    // cycle B: en=0, d=0xBB → reg8_en应当保持旧值
    sim_time += CLK_HALF_PERIOD; dut->clk=0; dut->d=0xBB; dut->en=0; dut->eval(); trace->dump(sim_time);
    sim_time += CLK_HALF_PERIOD; dut->clk=1; dut->eval(); trace->dump(sim_time);
    ref_dff8_q = 0xBB;
    // ref_reg8_en_q stays old value because en==0
    check_dut();

    // cycle C: en=0, d=0xCC → reg8_en继续保持
    sim_time += CLK_HALF_PERIOD; dut->clk=0; dut->d=0xCC; dut->en=0; dut->eval(); trace->dump(sim_time);
    sim_time += CLK_HALF_PERIOD; dut->clk=1; dut->eval(); trace->dump(sim_time);
    ref_dff8_q = 0xCC;
    // ref_reg8_en_q still unchanged
    check_dut();

    // cycle D: en=1, d=0xDD → reg8_en更新
    sim_time += CLK_HALF_PERIOD; dut->clk=0; dut->d=0xDD; dut->en=1; dut->eval(); trace->dump(sim_time);
    sim_time += CLK_HALF_PERIOD; dut->clk=1; dut->eval(); trace->dump(sim_time);
    ref_dff8_q = 0xDD;
    if(1) ref_reg8_en_q = 0xDD;
    check_dut();

    std::cout << "Deterministic sequence done.\n";
    /*
     * 故障注入验证演示：
     * 如果把上面两处
     *   if(1) ref_reg8_en_q = ...
     * 改成无条件 ref_reg8_en_q = ...
     * 即去掉使能判断，参考模型故障，测试会报MISMATCH，证明检查逻辑生效。
     */

    // ==============================
    // Test3：固定种子随机测试，120周期
    // 时序修正：低电平阶段先设置d/en → eval/dump → 再拉高时钟沿
    // ==============================
    std::cout << "\n==== Test3: Random test, 120 clock cycles ====\n";
    std::mt19937 rng(0x12345678U);
    std::uniform_int_distribution<> dist_d(0, 255);
    std::uniform_int_distribution<> dist_en(0, 1);
    const int CYCLE_TOTAL = 120;

    for(int cycle = 0; cycle < CYCLE_TOTAL; cycle++)
    {
        // 【低电平阶段】先施加激励，数据稳定，eval、dump
        sim_time += CLK_HALF_PERIOD;
        dut->clk = 0;
        uint8_t rand_d  = static_cast<uint8_t>(dist_d(rng));
        uint8_t rand_en = static_cast<uint8_t>(dist_en(rng));
        dut->d  = rand_d;
        dut->en = rand_en;
        dut->eval();
        trace->dump(sim_time);
        check_dut(); // 低电平阶段输出必须保持

        // 【上升沿】时钟拉高，产生posedge
        sim_time += CLK_HALF_PERIOD;
        dut->clk = 1;
        dut->eval();
        trace->dump(sim_time);

        // 更新软件参考模型：仅上升沿更新状态
        ref_dff8_q = rand_d;
        if(rand_en) {
            ref_reg8_en_q = rand_d;
        }
        check_dut();

        if(cycle % 10 == 0){
            std::printf("[%4luns] cycle=%3d en=%d d=0x%02X | dut dff8=0x%02X reg8=0x%02X ref dff8=0x%02X reg8=0x%02X\n",
                sim_time, cycle, (int)dut->en, (int)dut->d,
                (int)dut->dff8_q, (int)dut->reg8_en_q,
                (int)ref_dff8_q, (int)ref_reg8_en_q);
        }
    }

    std::cout << "\n==== Random test finish. total cycles:" << CYCLE_TOTAL
              << " error count:" << error_cnt << " ====\n";

    trace->flush();
    trace->close();
    delete trace;
    dut->final();
    delete dut;

    if(error_cnt > 0){
        std::cerr << "Simulation FAILED, total " << error_cnt << " mismatch(es)!\n";
        return EXIT_FAILURE;
    }else{
        std::cout << "All tests PASS! wave.vcd generated.\n";
        return EXIT_SUCCESS;
    }
}